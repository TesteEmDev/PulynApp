    "version": "0.2.0",
    "configurations": [
    
        {
            // Debug apontando para o backend local (http://192.168.0.50:3001). O celular precisa estar na mesma rede.
            "name": "pulyn_app (back local)",
            "request": "launch",
            "type": "dart",
            "toolArgs": ["--dart-define=PULYN_USE_LOCAL=true"]
        },
        {
            "name": "pulyn_app",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "pulyn_app (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "pulyn_app (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}