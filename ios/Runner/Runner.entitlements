<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: abre o app direto ao tocar em https://app.pulyn.com/family/invite/... -->
	<!-- Exige o arquivo apple-app-site-association hospedado no domínio (veja RELEASE.md). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.pulyn.com</string>
	</array>
	<!-- Ler a pulseira NFC (NTAG) para vincular a criança. Exige a capacidade "Near Field -->
	<!-- Communication Tag Reading" ativada no App ID da conta Apple Developer. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
