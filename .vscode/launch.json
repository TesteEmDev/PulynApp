{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    
        {
            // Debug apontando para o backend local. O endereço fica em config-local.json (PULYN_LOCAL_API).
            // O celular precisa estar na mesma rede.
            "name": "pulyn_app (back local)",
            "request": "launch",
            "type": "dart",
            "toolArgs": ["--dart-define-from-file=config-local.json"]
        },
        {
            "name": "pulyn_app",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "pulyn_app (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "pulyn_app (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}